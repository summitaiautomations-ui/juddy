# ---- Notion ----
# Create an internal integration at https://www.notion.so/my-integrations
# then share BOTH databases with it (••• → Connections → your integration).
NOTION_TOKEN=secret_xxx

# Data source (collection) IDs — already filled in for Summit's workspace.
NOTION_RECRUITING_DS=db7b25ed-d721-4a52-974b-58b3379f5309
NOTION_MORTGAGE_DS=4a3cbfe3-76a4-486f-8254-0b0b9c9d4115

# ---- Quo (= OpenPhone) ----
# The base64 "signing key" Quo shows when you create the webhook (Settings → Webhooks).
# Used to verify the openphone-signature header. Do NOT commit real values.
QUO_SIGNING_KEY=xxx

# ---- Service ----
PORT=8080
# Country calling code used to normalize phone numbers for matching (US = 1).
DEFAULT_COUNTRY_CODE=1
# Seconds to cache the phone→record index between webhook events (reduces Notion scans).
PHONE_CACHE_TTL_SECONDS=120
