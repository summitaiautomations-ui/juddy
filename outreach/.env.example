# Copy to ../.env (repo root) and fill in.

# Simply Texting — from your account → Settings → API Access
SIMPLETEXTING_API_KEY=
SIMPLETEXTING_ACCOUNT_PHONE=

# Notion — create an integration at https://www.notion.so/profile/integrations,
# then share the Mortgage Pipeline database with that integration.
NOTION_TOKEN=
NOTION_MORTGAGE_PIPELINE_DB=72d292078f454c35972fd9f5a54e51fb

# Gmail — used to send the daily outreach digest from your own inbox.
# App password is generated at https://myaccount.google.com/apppasswords
# (2-Step Verification must be on).
GMAIL_EMAIL=
GMAIL_APP_PASSWORD=

# Where the daily digest is delivered.
DIGEST_TO_EMAIL=

# Justin's personal cell — receives a brief SMS whenever a lead replies,
# so he can take over the conversation. 10-digit US format.
JUSTIN_PERSONAL_CELL=

# Optional overrides — leave unset to use the defaults.
# {name} = first name; {phone} = lead's phone (nudge only).
# BIRTHDAY_MESSAGE_TEMPLATE=Hey {name} — happy early birthday!
# NUDGE_MESSAGE_TEMPLATE={name} replied — your turn.

# Welcome SMS sent to every new Realtor.com lead.
# Fires immediately when the lead lands (no business-hours gate — leads
# come in early morning and Justin wants them texted then).
# REVIEW BEFORE DEPLOY — Justin dictated this verbatim and there are
# likely transcription artifacts:
#   "lost number 400661" → almost certainly "LO #400661" / "NMLS 400661"
#   "I understand that you and I got a note" → likely "I got a note"
# Welcome SMS is suppressed (and no text fires) until this variable is set.
# New leads are still created in Notion regardless, so nothing is lost.
# WELCOME_MESSAGE_TEMPLATE=Hi, my name is Justin Neal and I'm lost number 400661. I'm a mortgage banker in Plymouth, Minnesota. I understand that you and I got a note from realtor.com that you had some questions. Do you have a specific house in mind?

# Day-1 info touch SMS, sent a couple of hours after the welcome during
# business hours. Same suppress-until-set rule as the welcome.
# REVIEW BEFORE DEPLOY — Justin dictated this verbatim.
# INFO_TOUCH_MESSAGE_TEMPLATE=Hey, by the way, here is more information about myself and Summit Mortgage: https://linktr.ee/welcometosummit

# Business-hours window for the info touch (24-hour local time, default
# 9-21 / 9 AM – 9 PM). The welcome SMS is exempt from this gate — it
# fires whenever a new Realtor.com lead lands, including early morning.
# BUSINESS_HOURS_START=9
# BUSINESS_HOURS_END=21
