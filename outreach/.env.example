# Copy to ../.env (repo root) and fill in.

# Simply Texting — from your account → Settings → API Access
SIMPLETEXTING_API_KEY=
SIMPLETEXTING_ACCOUNT_PHONE=

# Notion — create an integration at https://www.notion.so/profile/integrations,
# then share the Mortgage Pipeline database with that integration.
NOTION_TOKEN=
NOTION_MORTGAGE_PIPELINE_DB=72d292078f454c35972fd9f5a54e51fb

# Gmail — used to send the daily outreach digest from your own inbox.
# App password is generated at https://myaccount.google.com/apppasswords
# (2-Step Verification must be on).
GMAIL_EMAIL=
GMAIL_APP_PASSWORD=

# Where the daily digest is delivered.
DIGEST_TO_EMAIL=

# Justin's personal cell — receives a brief SMS whenever a lead replies,
# so he can take over the conversation. 10-digit US format.
JUSTIN_PERSONAL_CELL=

# Optional overrides — leave unset to use the defaults.
# {name} = first name; {phone} = lead's phone (nudge only).
# BIRTHDAY_MESSAGE_TEMPLATE=Hey {name} — happy early birthday!
# NUDGE_MESSAGE_TEMPLATE={name} replied — your turn.
