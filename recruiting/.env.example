# Recruiting daily digest — add these to the shared ~/juddy/.env
# (the same file outreach/ uses; do NOT create a separate recruiting/.env)

# Notion integration token (already set if outreach is running)
NOTION_TOKEN=secret_xxx

# Recruiting Pipeline database. Optional — defaults to the known DB id.
# NOTION_RECRUITING_DB=e0a85bb7-a051-4af1-b549-92580e4bddb5

# Gmail sender (app password, not your login password)
GMAIL_EMAIL=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Who gets the daily recruiting email (comma-separated).
# Falls back to DIGEST_TO_EMAIL if unset.
RECRUITING_DIGEST_TO=justin@example.com

# The hiring goal the email tracks toward. Default 12.
# HIRING_GOAL=12

# Production caliber target: each hire should have produced this many
# units/month last year (2025 Units is annual; u/mo = units / 12).
# TARGET_UPM_MIN=2
# TARGET_UPM_HIGH=3

# A follow-up older than this many days counts as overdue. Default 0
# (overdue the day after it was due).
# RECRUITING_OVERDUE_DAYS=0
