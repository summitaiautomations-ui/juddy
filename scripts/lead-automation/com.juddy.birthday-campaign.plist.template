<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.juddy.birthday-campaign</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>__REPO__/lead-automation/birthday_campaign.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__REPO__/lead-automation</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
  </dict>

  <!-- Run once a day at 9:00 AM local time. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/juddy/birthday-campaign.out.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/juddy/birthday-campaign.err.log</string>
</dict>
</plist>
