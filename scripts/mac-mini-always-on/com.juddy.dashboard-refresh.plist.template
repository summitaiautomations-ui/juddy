<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.juddy.dashboard-refresh</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__REPO__/scripts/mac-mini-always-on/dashboard-refresh.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__REPO__/dashboard</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <!-- Set your Notion integration token here, or in dashboard-refresh.sh -->
        <key>NOTION_TOKEN</key>
        <string>__NOTION_TOKEN__</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>StartInterval</key>
    <integer>900</integer>

    <key>StandardOutPath</key>
    <string>/Users/__USER__/Library/Logs/juddy/dashboard-refresh.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/__USER__/Library/Logs/juddy/dashboard-refresh.log</string>
</dict>
</plist>
