# Copy this file to ".env" and paste in your keys.

# Free at https://console.picovoice.ai/  (Access Key on the home page)
PICOVOICE_ACCESS_KEY=

# Your Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Your Notion internal integration token (the same one the dashboard uses)
NOTION_TOKEN=

# Optional overrides:
# WHISPER_MODEL=small.en   # tiny.en is faster but less accurate; medium.en more accurate
# TTS_VOICE=Daniel         # other good butler voices: Oliver, Serena, Rishi
# TTS_RATE=190             # words per minute
